<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Portal</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

<header>
    <h1 class="logo">Student Portal</h1>

    <nav>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Courses</a></li>
            <li><a href="#">Profile</a></li>
            <li><a href="#">Grades</a></li>
        </ul>
    </nav>
</header>

<section class="hero">
    <h2>Welcome to Student Portal</h2>
    <p>Manage your courses and academic information easily.</p>
    <button>Explore Courses</button>
</section>

<section class="stats">
    <div class="stat-box">
        <h3>3</h3>
        <p>Courses Enrolled</p>
    </div>

    <div class="stat-box">
        <h3>3.8</h3>
        <p>GPA</p>
    </div>

    <div class="stat-box">
        <h3>6</h3>
        <p>Semester</p>
    </div>
</section>

<section class="courses">

    <h2>Available Courses</h2>

    <div class="course-grid">

        <article class="course-card">
            <h3>HTML5</h3>
            <p>Learn semantic HTML.</p>
            <span>Credits : 3</span>
        </article>

        <article class="course-card">
            <h3>CSS3</h3>
            <p>Learn styling and layouts.</p>
            <span>Credits : 4</span>
        </article>

        <article class="course-card">
            <h3>JavaScript</h3>
            <p>Programming for web.</p>
            <span>Credits : 4</span>
        </article>

        <article class="course-card">
            <h3>React</h3>
            <p>Frontend framework.</p>
            <span>Credits : 4</span>
        </article>

        <article class="course-card">
            <h3>Node.js</h3>
            <p>Backend JavaScript.</p>
            <span>Credits : 3</span>
        </article>

    </div>

</section>

<footer>
    <p>&copy; 2026 Student Portal</p>
</footer>

</body>
</html>




*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:#f4f4f4;
    color:#333;
}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px;
    background:#1e3a8a;
    color:white;
}

nav ul{
    display:flex;
    list-style:none;
    gap:20px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

.hero{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    min-height:40vh;
    text-align:center;
    padding:40px 20px;
    background:#2563eb;
    color:white;
}

.hero button{
    margin-top:20px;
    padding:12px 25px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.hero button:hover{
    background:#ddd;
}

.stats{
    display:flex;
    justify-content:space-evenly;
    flex-wrap:wrap;
    padding:30px;
    background:white;
}

.stat-box{
    text-align:center;
    padding:20px;
}

.courses{
    padding:40px;
}

.course-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
    margin-top:20px;
}

.course-card{
    background:white;
    padding:20px;
    border-radius:10px;
    box-shadow:0 0 10px rgba(0,0,0,.1);
    min-height:180px;
}

.logo{
    font-size:clamp(1.5rem,3vw,2.5rem);
}

footer{
    text-align:center;
    padding:20px;
    background:#1e3a8a;
    color:white;
}

@media(min-width:768px){

    .course-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(min-width:1024px){

    .course-grid{
        grid-template-columns:repeat(3,1fr);
    }




